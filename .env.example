# 이 파일을 복사해 .env 를 만들고 값을 직접 채우세요. (.env 는 .gitignore에 들어 있어 GitHub에 올라가지 않습니다)
# 스크립트 실행: node --env-file=.env scripts/register-commands.mjs
#                node --env-file=.env scripts/restore.mjs <invest-backup 폴더> --dry-run

# scripts/register-commands.mjs (Discord 슬래시 명령 등록)
DISCORD_APP_ID=
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=

# scripts/restore.mjs (백업 복구)
SUPABASE_URL=
SUPABASE_KEY=
GEMINI_API_KEY=
