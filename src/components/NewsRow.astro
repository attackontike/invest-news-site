---
import type { Item } from '../lib/news';
import { fmtTime } from '../lib/format';

interface Props { item: Item; compact?: boolean }
const { item, compact = false } = Astro.props;
const title = item.titleKo || item.title;
const bars = Math.max(1, Math.min(5, Math.ceil(item.importance / 20)));
const marketLabel = item.market === 'KR' ? '국내' : item.market === 'US' ? '미국' : '해외';
---
<li class="row" data-market={item.market === 'KR' ? 'KR' : 'US'} data-sentiment={item.sentiment}>
  <div class="meter" role="img" aria-label={`중요도 ${item.importance}점`} title={`중요도 ${item.importance}점`}>
    {[5, 4, 3, 2, 1].map((n) => <span class={n <= bars ? 'on' : ''}></span>)}
  </div>
  <div class="row-body">
    <p class="meta">
      <span class="grade" data-grade={item.sourceGrade}>{item.sourceGrade}</span>
      <span class="src">{item.source}</span>
      <time datetime={item.publishedAt}>{fmtTime(item.publishedAt)}</time>
      <span class="mkt">{marketLabel}</span>
    </p>
    <h3 class="title"><a href={item.url} target="_blank" rel="noopener noreferrer">{title}</a></h3>
    {!compact && item.titleKo && item.titleKo !== item.title && <p class="orig" lang={item.market === 'KR' ? 'ko' : 'en'}>{item.title}</p>}
    {item.summary && <p class="sum">{item.summary}</p>}
    {!compact && item.keyPoints.length > 0 && (
      <details class="points">
        <summary>핵심 내용 {item.keyPoints.length}가지</summary>
        <ul>{item.keyPoints.map((p) => <li>{p}</li>)}</ul>
      </details>
    )}
    <p class="chips">
      <span class="tone" data-tone={item.sentiment}>{item.sentiment}</span>
      {item.tickers.map((t) => <span class="ticker">{t.name}{t.code && <small>{t.code}</small>}</span>)}
      {!compact && item.tags.map((t) => <span class="tag">#{t}</span>)}
      {item.coverage > 1 && <span class="cover">{item.coverage}개 매체 보도</span>}
    </p>
  </div>
</li>
