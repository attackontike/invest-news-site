---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
---
<BaseLayout title="검색" description="지난 기사·공시·리서치·주간 리포트 검색" section="search">
  <PageHead title="검색" lead="날짜별 기사·공시, 리서치, 주간 리포트에서 찾습니다. 종목명, 회사명, 주제어로 검색해 보세요. 붙여 쓴 이름은 앞부분부터 입력해야 찾습니다 (예: 'SK하이닉스'는 찾고 '하이닉스'는 못 찾음)." />
  <div id="search" class="search-box"></div>
  <noscript><p class="none">검색은 자바스크립트가 켜져 있어야 동작합니다.</p></noscript>
  <p class="sec-note">검색 색인은 사이트가 배포될 때마다 새로 만들어집니다. 로컬 개발 서버(npm run dev)에서는 동작하지 않고, 빌드한 사이트에서만 동작합니다.</p>
</BaseLayout>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    if (!window.PagefindUI) { document.getElementById('search').textContent = '검색 색인을 불러오지 못했습니다.'; return; }
    // 사이트 주소는 끝에 / 를 붙이지 않음 (예: /research/abc/#s-news → /research/abc#s-news)
    const tidy = (u) => String(u || '').replace(/\/(?=#|$)/, '');
    const processResult = (r) => { r.url = tidy(r.url); (r.sub_results || []).forEach((s) => { s.url = tidy(s.url); }); return r; };
    const ui = new PagefindUI({ element: '#search', showSubResults: true, showImages: false, resetStyles: false, pageSize: 10, processResult });
    const q = new URLSearchParams(location.search).get('q');
    if (q) ui.triggerSearch(q);
  });
</script>
