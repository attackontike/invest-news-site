---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import NewsRow from '../components/NewsRow.astro';
import Empty from '../components/Empty.astro';
import FilterScript from '../components/FilterScript.astro';
import { loadNews, groupByDay, RULES } from '../lib/news';
import { fmtDay } from '../lib/format';

const { news, ref } = await loadNews();
const days = groupByDay(news);
const count = (m: 'KR' | 'US') => news.filter((n) => (m === 'KR' ? n.market === 'KR' : n.market !== 'KR')).length;
---
<BaseLayout title="시장 뉴스" description="최근 7일 국내·미국 시장 뉴스" section="news">
  <PageHead
    title="시장 뉴스"
    lead="신뢰도 기준을 통과한 기사를 날짜별로, 하루 안에서는 중요도순으로 보여 줍니다."
    rule={`최근 ${RULES.newsDays}일, ${news.length}건`}
  />

  {news.length === 0 ? <Empty /> : (
    <>
      <div class="filters" role="group" aria-label="기사 거르기">
        <div class="seg" data-filter="market">
          <button type="button" aria-pressed="true" data-value="all">전체 {news.length}</button>
          <button type="button" aria-pressed="false" data-value="KR">국내 {count('KR')}</button>
          <button type="button" aria-pressed="false" data-value="US">미국·해외 {count('US')}</button>
        </div>
        <div class="seg" data-filter="sentiment">
          <button type="button" aria-pressed="true" data-value="all">모든 논조</button>
          <button type="button" aria-pressed="false" data-value="호재">호재</button>
          <button type="button" aria-pressed="false" data-value="악재">악재</button>
        </div>
      </div>

      {days.map((d) => (
        <section class="day" aria-label={fmtDay(d.day)}>
          <h2 class="day-h">{fmtDay(d.day, ref)} <span>{d.items.length}건</span></h2>
          <ol class="rows">{d.items.map((it) => <NewsRow item={it} />)}</ol>
        </section>
      ))}
      <p class="none" id="no-match" hidden>조건에 맞는 기사가 없습니다. 위에서 다른 조건을 골라 보세요.</p>
    </>
  )}
</BaseLayout>

<FilterScript />
