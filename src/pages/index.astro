---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import NewsRow from '../components/NewsRow.astro';
import Empty from '../components/Empty.astro';
import { loadNews, RULES } from '../lib/news';
import { fmtDateTime, briefingHtml } from '../lib/format';
import { upcoming, marketStrip, thermometer, fmtValue } from '../lib/market';
import { getCollection } from 'astro:content';

const { editions, top, topFilings } = await loadNews();
const soonEvents = upcoming(1);
const temp = thermometer();
const lastWeekly = (await getCollection('weekly')).sort((a, b) => b.data.week.localeCompare(a.data.week))[0];
const [latest, ...earlier] = editions;
---
<BaseLayout title="시장 브리핑" description="국내·미국 시장 뉴스 요약" section="brief">
  <PageHead
    title="시장 브리핑"
    lead="매일 07:00, 12:00, 16:30, 22:00에 그때까지 나온 뉴스를 모아 요약합니다."
  />

  {(marketStrip.length > 0 || temp) && (
    <section class="mkt-strip" aria-label="시장 요약">
      {marketStrip.map((i) => (
        <a class="mkt-cell" href="/data" data-dir={i.pct === null || i.pct === 0 ? 'flat' : i.pct > 0 ? 'up' : 'down'}>
          <span class="mkt-name">{i.short}</span>
          <span class="mkt-val">{fmtValue(i.value, i.unit === '원' ? '원' : '')}</span>
          <span class="mkt-chg">{i.pct === null ? '' : `${i.pct > 0 ? '▲' : i.pct < 0 ? '▼' : ''} ${Math.abs(i.pct).toLocaleString('ko-KR')}%`}</span>
          <span class="mkt-date">{i.date.slice(5).replace('-', '.')} 종가</span>
        </a>
      ))}
      {temp && (
        <a class="mkt-cell mkt-mood" href="/data#g-mood" data-level={temp.level}>
          <span class="mkt-name">시장 온도계</span>
          <span class="mkt-val">{temp.label}</span>
          <span class="mkt-chg">VIX {temp.vix ?? '-'}</span>
          <span class="mkt-date">참고용</span>
        </a>
      )}
    </section>
  )}

  {!latest ? <Empty /> : (
    <>
      <section class="brief" aria-labelledby="brief-h">
        <h2 id="brief-h" class="brief-h">
          {latest.edition} 브리핑
          <time datetime={latest.generatedAt}>{fmtDateTime(latest.generatedAt)}</time>
        </h2>
        <ul class="brief-lines">
          {latest.briefing.map((line) => <li set:html={briefingHtml(line)} />)}
        </ul>
        {earlier.length > 0 && (
          <details class="brief-earlier">
            <summary>오늘 앞선 브리핑 {earlier.length}개</summary>
            {earlier.map((e) => (
              <div class="brief-old">
                <h3>{e.edition} 브리핑</h3>
                <ul>{e.briefing.map((line) => <li set:html={briefingHtml(line)} />)}</ul>
              </div>
            ))}
          </details>
        )}
      </section>

      {lastWeekly && (
        <p class="weekly-link">🗓️ <a href={`/weekly/${lastWeekly.data.week}`}>{lastWeekly.data.title}</a>{lastWeekly.data.report.headline && <span> · {lastWeekly.data.report.headline}</span>}</p>
      )}

      {soonEvents.length > 0 && (
        <section class="today-ev" aria-labelledby="tev-h">
          <h2 id="tev-h" class="sec-h">오늘·내일 경제 일정</h2>
          <ul class="ev-list">
            {soonEvents.map((e) => (
              <li data-imp={e.importance}>
                <span class="ev-time">{e.date.slice(5).replace('-', '.')} {e.time ?? ''}</span>
                <span class="ev-flag">{e.market === 'US' ? '미국' : '한국'}</span>
                <span class="ev-name">{e.name}</span>
                <span class="ev-imp">{'★'.repeat(e.importance)}</span>
              </li>
            ))}
          </ul>
          <p class="sec-note"><a href="/data">지표와 2주 일정 보기</a></p>
        </section>
      )}

      {topFilings.length > 0 && (
        <section class="filings-top" aria-labelledby="fl-h">
          <h2 id="fl-h" class="sec-h">주요 공시·공식 발표</h2>
          <p class="sec-note">최근 {RULES.topHours}시간, 중요도순 · <a href="/filings">전체 보기</a></p>
          <ol class="rows">{topFilings.map((it) => <NewsRow item={it} compact />)}</ol>
        </section>
      )}

      <div class="split">
        <section aria-labelledby="kr-h">
          <h2 id="kr-h" class="sec-h">국내 주요 뉴스</h2>
          <p class="sec-note">최근 {RULES.topHours}시간, 중요도순</p>
          {top.KR.length ? <ol class="rows">{top.KR.map((it) => <NewsRow item={it} compact />)}</ol> : <p class="none">해당 기간 기사가 없습니다.</p>}
        </section>
        <section aria-labelledby="us-h">
          <h2 id="us-h" class="sec-h">미국·해외 주요 뉴스</h2>
          <p class="sec-note">최근 {RULES.topHours}시간, 중요도순</p>
          {top.US.length ? <ol class="rows">{top.US.map((it) => <NewsRow item={it} compact />)}</ol> : <p class="none">해당 기간 기사가 없습니다.</p>}
        </section>
      </div>
      <p class="more"><a href="/news">최근 7일 시장 뉴스 전체 보기</a></p>
    </>
  )}
</BaseLayout>
