---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  description: string;
  section: 'brief' | 'news' | 'filings' | 'watchlist' | 'research' | 'data';
}
const { title, description, section } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <title>{title} | 투자 뉴스 브리프</title>
  </head>
  <body data-section={section}>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    <div class="shell">
      <Sidebar current={section} />
      <main id="main" class="main">
        <slot />
        <footer class="foot">
          <p>
            공시, 언론 보도, 데이터를 자동으로 모아 AI가 요약한 정보 정리 페이지입니다. 호재·악재 표시는 기사 논조를 분류한 것이며
            매수·매도 의견이 아닙니다. 투자 판단 전에 반드시 원문을 확인하세요.
          </p>
        </footer>
      </main>
    </div>
  </body>
</html>
